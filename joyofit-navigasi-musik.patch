@@ -28,6 +28,45 @@ internal object NotificationPolicy {
     else -> null
   }
 
+  /**
+   * Turn-by-turn navigation apps whose ongoing navigation notification is forwarded anyway, so the
+   * watch shows the next instruction. Only a change of instruction is sent (see [navigationKey]).
+   */
+  val NAVIGATION_PACKAGES = setOf(
+    "com.google.android.apps.maps", // Google Maps
+    "com.waze", // Waze
+  )
+
+  /** `Notification.CATEGORY_NAVIGATION` (API 31); the literal so older phones match too. */
+  const val CATEGORY_NAVIGATION = "navigation"
+
+  /**
+   * A navigation app's live guidance notification: its navigation category, or an ongoing entry
+   * from that app (older Maps versions do not set the category). Other notifications of the same
+   * app, such as reviews or offers, take the normal path.
+   */
+  fun isNavigation(sourcePackage: String, category: String?, flags: Int): Boolean =
+    sourcePackage in NAVIGATION_PACKAGES &&
+      (category == CATEGORY_NAVIGATION || flags and ONGOING_MASK != 0)
+
+  /** Numbers with their units: "200 m", "1,2 km", "14:05", "12 menit". */
+  private val NUMBER_WITH_UNIT = Regex(
+    """\d[\d.,:]*\s*(km|m|mi|ft|yd|menit|mnt|min|jam|hr|h)?\b""",
+    RegexOption.IGNORE_CASE,
+  )
+
+  /**
+   * What identifies one navigation instruction: the text without distances and times. Maps reposts
+   * the notification as the distance counts down ("200 m" -> "150 m"); those reposts give the same
+   * key and are not sent, so the watch buzzes only when the next turn changes.
+   */
+  fun navigationKey(title: String?, body: String?): String =
+    listOfNotNull(title, body).joinToString("\n")
+      .replace(NUMBER_WITH_UNIT, "")
+      .replace(Regex("""\s+"""), " ")
+      .trim()
+      .lowercase()
+
   /** An explicit per-app choice wins; otherwise every app is on except system apps. */
   fun appAllowed(explicitChoice: Boolean?, isSystemApp: Boolean): Boolean = explicitChoice ?: !isSystemApp
 
