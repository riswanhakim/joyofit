+  /** The navigation instruction last shown on the watch, removed when the next one arrives. */
+  private var lastNavigation: WatchNotification? = null
+
+  /**
+   * Google Maps / Waze guidance: skips the ongoing and local-only filters, sends only when the
+   * instruction changes (not on every distance update) and replaces the previous instruction on the
+   * watch. The app can still be switched off in the notification app list.
+   */
+  private fun onNavigation(sbn: StatusBarNotification, notification: Notification, title: String?, body: String?) {
+    if (title.isNullOrBlank() && body.isNullOrBlank()) return
+    if (settings.appChoice(sbn.packageName) == false) return
+    val key = NotificationPolicy.navigationKey(title, body)
+    val hash = listOf(key, sbn.packageName).hashCode()
+    val spec: WatchNotification
+    val previous: WatchNotification?
+    synchronized(lock) {
+      if (lastSent[sbn.key] == hash) return
+      if (lastSent.size > MAX_TRACKED) lastSent.clear()
+      lastSent[sbn.key] = hash
+      val appInfo = applicationInfo(sbn.packageName, notification.extras)
+      spec = WatchNotification(
+        id = nextId++,
+        key = sbn.key ?: "",
+        sourceAppId = sbn.packageName,
+        sourceName = appInfo?.let { label(it) } ?: sbn.packageName,
+        title = title,
+        body = body,
+        channelId = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) notification.channelId else null,
+        category = notification.category,
+        whenMs = System.currentTimeMillis(),
+        isEmail = false,
+      )
+      previous = lastNavigation
+      lastNavigation = spec
+      if (previous != null) cache.remove(previous)
+      if (cache.size > 10) cache.poll()
+      cache.offer(spec)
+    }
+    scope.launch {
+      if (previous != null) remove(previous)
+      send(spec)
+    }
+  }
+
   fun onRemoved(sbn: StatusBarNotification) {
     val spec: WatchNotification?
     synchronized(lock) {
       lastSent.remove(sbn.key)
       val found = cache.firstOrNull { it.key == sbn.key && it.sourceAppId == sbn.packageName }
       if (found != null) cache.remove(found)
+      if (found != null && found.id == lastNavigation?.id) lastNavigation = null
       spec = found
     }
     if (spec == null) return
