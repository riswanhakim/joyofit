+  @Test
+  fun distanceCountdownKeepsTheSameKeyButANewTurnChangesIt() {
+    val a = NotificationPolicy.navigationKey("Belok kiri dalam 200 m", "Jl. Sudirman · 12 menit · 3,4 km · tiba 14:05")
+    val b = NotificationPolicy.navigationKey("Belok kiri dalam 150 m", "Jl. Sudirman · 11 menit · 3,3 km · tiba 14:05")
+    val c = NotificationPolicy.navigationKey("Belok kiri dalam 1,2 km", "Jl. Sudirman · 11 menit · 3,3 km · tiba 14:06")
+    val d = NotificationPolicy.navigationKey("Belok kanan dalam 300 m", "Jl. Thamrin · 10 menit · 2,9 km · tiba 14:06")
+    assertEquals(a, b)
