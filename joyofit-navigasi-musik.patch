+    assertTrue(NotificationPolicy.isNavigation(maps, "navigation", 0))
+    assertTrue(NotificationPolicy.isNavigation(maps, null, Notification.FLAG_ONGOING_EVENT))
+    assertFalse(NotificationPolicy.isNavigation(maps, null, 0))
+    assertFalse(NotificationPolicy.isNavigation("com.chat", "navigation", Notification.FLAG_ONGOING_EVENT))
+  }
