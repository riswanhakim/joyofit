+// Derived from Gadgetbridge (AGPL-3.0-or-later; see NOTICE): service/devices/huawei/AsynchronousResponse.handleMusicControls,
+// HuaweiSupportProvider.{onSetMusicState,onSetMusicInfo,sendSetMusic}, HuaweiMediaManager and requests/{SetMusicRequest,
+// SetMusicStatusRequest}.
+package com.joyodigitama.huaweiwear
+
+import android.content.BroadcastReceiver
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.media.AudioManager
+import android.media.MediaMetadata
+import android.media.session.MediaController
+import android.media.session.MediaSessionManager
+import android.media.session.PlaybackState
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import android.view.KeyEvent
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import nodomain.freeyourgadget.gadgetbridge.devices.huawei.HuaweiPacket
+import nodomain.freeyourgadget.gadgetbridge.devices.huawei.packets.MusicControl
+
+/**
+ * The watch's music screen as a remote for whatever plays on the phone (Spotify, YouTube Music,
+ * ...): the phone sends artist, title, play state and volume (25/02); the watch sends its buttons
+ * and volume (25/03) and asks for the status when the screen opens (25/01).
+ *
+ * The playing app is found through Android's media sessions, which needs the notification access
+ * JoyoFit already asks for. Without it the buttons still work as media keys, but the watch shows no
+ * title.
+ */
+internal class MusicController(
+  context: Context,
+  private val link: WearLink,
+  private val events: WearEvents,
+  private val scope: CoroutineScope,
+) {
+  private val appContext = context.applicationContext
+  private val audio = appContext.getSystemService(Context.AUDIO_SERVICE) as AudioManager
+  private val sessions = appContext.getSystemService(Context.MEDIA_SESSION_SERVICE) as MediaSessionManager
+  private val listenerComponent = ComponentName(appContext, WatchNotificationListener::class.java)
+  private val main = Handler(Looper.getMainLooper())
+
+  private var attached: HuaweiSession? = null
+  private val subscriptions = ArrayList<AutoCloseable>()
+
+  /** Main thread only: the session being followed and its callback. */
+  @Volatile private var controller: MediaController? = null
+  private var tracking = false
+  private var pushJob: Job? = null
+
+  /** What was last sent, so a repeat (state callbacks fire often) is not sent again. */
+  @Volatile private var lastSent: List<Any?>? = null
+
+  private fun log(message: String) = events.log(LogDirection.INFO, null, null, null, message)
+
+  private fun error(message: String) = events.log(LogDirection.ERROR, null, null, null, message)
+
+  @Synchronized
+  fun onLinkState(state: LinkState) {
+    when (state) {
+      LinkState.CONNECTED, LinkState.SYNCING -> {
+        val session = link.handle()?.session ?: return
+        if (session === attached) return
+        detach()
+        attached = session
+        subscriptions += session.subscribe(MusicControl.id, MusicControl.MusicStatusResponse.id, "music status") { onStatusAsked(it) }
+        subscriptions += session.subscribe(MusicControl.id, MusicControl.Control.id, "music control") { onButton(it) }
+        main.post { startTracking() }
+      }
+      LinkState.DISCONNECTED -> {
+        detach()
+        main.post { stopTracking() }
+      }
+      else -> Unit
+    }
+  }
+
+  private fun detach() {
+    subscriptions.forEach { it.close() }
+    subscriptions.clear()
+    attached = null
+    lastSent = null
+  }
+
+  // Watch -> phone
+
+  /** AsynchronousResponse.handleMusicControls, command 01. Runs on the read thread. */
+  private fun onStatusAsked(packet: HuaweiPacket) {
+    val status = try {
+      packet.parseTlv()
+      (packet as MusicControl.MusicStatusResponse).status
+    } catch (e: Exception) {
+      error("Music: could not parse the watch's status request: ${e.message}")
+      return
+    }
+    if (status != -1 && status != MusicControl.successValue) {
+      log("Music: the watch reported status 0x${Integer.toHexString(status)}, not answering")
+      return
+    }
+    scope.launch {
+      acknowledge(MusicControl.MusicStatusResponse.id)
+      main.post {
+        followActiveSession()
+        lastSent = null
+        schedulePush()
+      }
+    }
+  }
+
+  /** AsynchronousResponse.handleMusicControls, command 03. Runs on the read thread. */
+  private fun onButton(packet: HuaweiPacket) {
+    val resp = try {
+      packet.parseTlv()
+      packet as MusicControl.Control.Response
+    } catch (e: Exception) {
+      error("Music: could not parse the watch's button: ${e.message}")
+      return
+    }
+    val button = if (resp.buttonPresent) resp.button else null
+    val volume = if (resp.volumePresent) resp.volume.toInt() and 0xFF else null
+    if (button == null && volume == null) return
+    scope.launch {
+      main.post {
+        if (button != null && button != MusicControl.Control.Response.Button.Unknown) press(button)
+        if (volume != null) setVolume(volume)
+      }
+      acknowledge(MusicControl.Control.id)
+      // GB waits a moment so the player has changed state before the watch is updated.
+      delay(BUTTON_SETTLE_MS)
+      lastSent = null
+      pushNow()
+    }
+  }
+
+  /** Main thread. Uses the followed player when there is one, else a media key (reaches the last player). */
+  private fun press(button: MusicControl.Control.Response.Button) {
+    val controls = controller?.transportControls
+    log("Music: ${button.name} from the watch")
+    when (button) {
+      MusicControl.Control.Response.Button.Play -> controls?.play() ?: mediaKey(KeyEvent.KEYCODE_MEDIA_PLAY)
+      MusicControl.Control.Response.Button.Pause -> controls?.pause() ?: mediaKey(KeyEvent.KEYCODE_MEDIA_PAUSE)
+      MusicControl.Control.Response.Button.Previous -> controls?.skipToPrevious() ?: mediaKey(KeyEvent.KEYCODE_MEDIA_PREVIOUS)
+      MusicControl.Control.Response.Button.Next -> controls?.skipToNext() ?: mediaKey(KeyEvent.KEYCODE_MEDIA_NEXT)
+      MusicControl.Control.Response.Button.Volume_up ->
+        audio.adjustStreamVolume(AudioManager.STREAM_MUSIC, AudioManager.ADJUST_RAISE, 0)
+      MusicControl.Control.Response.Button.Volume_down ->
+        audio.adjustStreamVolume(AudioManager.STREAM_MUSIC, AudioManager.ADJUST_LOWER, 0)
+      else -> Unit
+    }
+  }
+
+  private fun mediaKey(code: Int) {
+    val now = SystemClock.uptimeMillis()
+    audio.dispatchMediaKeyEvent(KeyEvent(now, now, KeyEvent.ACTION_DOWN, code, 0))
+    audio.dispatchMediaKeyEvent(KeyEvent(now, now, KeyEvent.ACTION_UP, code, 0))
+  }
+
+  /** Same range checks as GB: a volume outside the stream's range is ignored. */
+  private fun setVolume(volume: Int) {
+    val max = audio.getStreamMaxVolume(AudioManager.STREAM_MUSIC)
+    val min = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) audio.getStreamMinVolume(AudioManager.STREAM_MUSIC) else 0
+    if (volume !in min..max) {
+      log("Music: volume $volume from the watch ignored (range $min..$max)")
+      return
+    }
+    audio.setStreamVolume(AudioManager.STREAM_MUSIC, volume, 0)
+  }
+
+  private suspend fun acknowledge(commandId: Byte) {
+    val handle = link.handle() ?: return
+    try {
+      handle.session.send(MusicControl.MusicStatusRequest(handle.session.params, commandId, MusicControl.successValue), "MusicAck")
+    } catch (e: CancellationException) {
+      throw e
+    } catch (e: Exception) {
+      error("Music: acknowledgement not sent: ${e.message}")
+    }
+  }
+
+  // Phone -> watch
+
+  /** SetMusicRequest: artist, title, PlaybackState value, max and current STREAM_MUSIC volume. */
+  private suspend fun pushNow() {
+    val handle = link.handle() ?: return
+    val now = snapshot()
+    if (now == lastSent) return
+    lastSent = now
+    val (artist, title, state, max, volume) = now
+    try {
+      val packet = MusicControl.MusicInfo.Request(
+        handle.session.params, artist as String, title as String, state as Byte, max as Byte, volume as Byte,
+      )
+      val reply = handle.session.request(packet, Timeouts.QUERY_MS, "MusicInfo")
+      if (reply is MusicControl.MusicInfo.Response && !reply.ok) error("Music: ${reply.error}")
+    } catch (e: CancellationException) {
+      throw e
+    } catch (e: Exception) {
+      lastSent = null
+      error("Music: info not sent: ${e.message}")
+    }
+  }
+
+  private fun snapshot(): List<Any?> {
+    val c = controller
+    val meta = c?.metadata
+    val artist = meta?.getString(MediaMetadata.METADATA_KEY_ARTIST)
+      ?: meta?.getString(MediaMetadata.METADATA_KEY_ALBUM_ARTIST) ?: ""
+    val title = meta?.getString(MediaMetadata.METADATA_KEY_TITLE)
+      ?: meta?.getString(MediaMetadata.METADATA_KEY_DISPLAY_TITLE) ?: ""
+    val state = when (c?.playbackState?.state) {
+      PlaybackState.STATE_PLAYING, PlaybackState.STATE_BUFFERING -> PlaybackState.STATE_PLAYING
+      PlaybackState.STATE_PAUSED -> PlaybackState.STATE_PAUSED
+      PlaybackState.STATE_STOPPED -> PlaybackState.STATE_STOPPED
+      else -> PlaybackState.STATE_NONE
+    }
+    return listOf(
+      artist.take(MAX_TEXT),
+      title.take(MAX_TEXT),
+      state.toByte(),
+      audio.getStreamMaxVolume(AudioManager.STREAM_MUSIC).toByte(),
+      audio.getStreamVolume(AudioManager.STREAM_MUSIC).toByte(),
+    )
+  }
+
+  /** Coalesces the bursts of callbacks a track change produces into one packet. */
+  private fun schedulePush() {
+    if (link.handle() == null) return
+    pushJob?.cancel()
+    pushJob = scope.launch {
+      delay(PUSH_DEBOUNCE_MS)
+      pushNow()
+    }
+  }
+
+  // Following the playing app (main thread)
+
+  private val sessionCallback = object : MediaController.Callback() {
+    override fun onMetadataChanged(metadata: MediaMetadata?) = schedulePush()
+
+    override fun onPlaybackStateChanged(state: PlaybackState?) {
+      // Another app may have started playing while this one paused.
+      followActiveSession()
+      schedulePush()
+    }
+
+    override fun onSessionDestroyed() {
+      followActiveSession()
+      schedulePush()
+    }
+  }
+
+  private val sessionsChanged = MediaSessionManager.OnActiveSessionsChangedListener {
+    followActiveSession()
+    schedulePush()
+  }
+
+  private val volumeReceiver = object : BroadcastReceiver() {
+    override fun onReceive(context: Context?, intent: Intent?) = schedulePush()
+  }
+
+  private fun startTracking() {
+    if (tracking) return
+    tracking = true
+    try {
+      sessions.addOnActiveSessionsChangedListener(sessionsChanged, listenerComponent, main)
+    } catch (e: SecurityException) {
+      log("Music: no notification access, the watch gets buttons but no track info")
+    }
+    val filter = IntentFilter(VOLUME_CHANGED_ACTION)
+    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+      appContext.registerReceiver(volumeReceiver, filter, Context.RECEIVER_EXPORTED)
+    } else {
+      appContext.registerReceiver(volumeReceiver, filter)
+    }
+    followActiveSession()
+    schedulePush()
+  }
+
+  private fun stopTracking() {
+    if (!tracking) return
+    tracking = false
+    pushJob?.cancel()
+    try {
+      sessions.removeOnActiveSessionsChangedListener(sessionsChanged)
+    } catch (e: Exception) {
+      // Not registered (no notification access).
+    }
+    try {
+      appContext.unregisterReceiver(volumeReceiver)
+    } catch (e: IllegalArgumentException) {
+      // Not registered.
+    }
+    follow(null)
+  }
+
+  /** Picks the session that is playing, else the most recent one (Android lists them newest first). */
+  private fun followActiveSession() {
+    val active = try {
+      sessions.getActiveSessions(listenerComponent)
+    } catch (e: SecurityException) {
+      emptyList()
+    }
+    val pick = active.firstOrNull { it.playbackState?.state == PlaybackState.STATE_PLAYING } ?: active.firstOrNull()
+    if (pick?.sessionToken != controller?.sessionToken) follow(pick)
+  }
+
+  private fun follow(next: MediaController?) {
+    controller?.unregisterCallback(sessionCallback)
+    controller = next
+    next?.registerCallback(sessionCallback, main)
+    if (next != null) log("Music: following ${next.packageName}")
+  }
+
+  private companion object {
+    const val BUTTON_SETTLE_MS = 500L
+    const val PUSH_DEBOUNCE_MS = 300L
+
+    /** Keeps the packet small; the watch only shows a line or two. */
+    const val MAX_TEXT = 64
+
+    /** AudioManager.VOLUME_CHANGED_ACTION, a hidden constant that the system still broadcasts. */
+    const val VOLUME_CHANGED_ACTION = "android.media.VOLUME_CHANGED_ACTION"
+  }
+}
